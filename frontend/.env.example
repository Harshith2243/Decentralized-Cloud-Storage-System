# Copy this file to .env (Vite auto-loads .env; never commit the real one).
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Paste the address printed by:
#   npx hardhat run scripts/deploy.js --network localhost
# Deploying fresh from a freshly started `npx hardhat node` with the default
# account/nonce will normally produce this address as the FIRST contract
# deployed — confirm it against your own deploy output before trusting it:
VITE_CONTRACT_ADDRESS= 0x5FbDB2315678afecb367f032d93F642f64180aa3

# 31337 = Hardhat's local network. Use 11155111 for Sepolia later.
VITE_CHAIN_ID=31337
VITE_NETWORK_NAME=Hardhat Local
VITE_RPC_URL=http://127.0.0.1:8545

# Backend API (Phase 4). Public URL only; never put IPFS tokens or secrets in a VITE_ variable.
VITE_BACKEND_URL=http://localhost:5000
