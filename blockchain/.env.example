# Copy this file to .env and fill in your own values. NEVER commit the real .env file.

# RPC endpoint for the Sepolia testnet (e.g. from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of a TESTNET-ONLY wallet used to deploy contracts.
# Never use a wallet that holds real funds.
PRIVATE_KEY=your_testnet_wallet_private_key
