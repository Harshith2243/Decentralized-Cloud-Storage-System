# Backend environment. Copy to backend/.env (never commit the real file).
# These are SERVER-SIDE values. Never put secrets in frontend/.env (VITE_ vars are public).

PORT=5000

# Browser origin(s) allowed to call this API, comma separated (no "*").
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- IPFS storage (Phase 4) ---
# Only "kubo" is implemented: a Kubo (go-ipfs) node's HTTP RPC API.
IPFS_PROVIDER=kubo
# Local dev node started with `ipfs daemon`. NEVER expose this RPC port publicly.
IPFS_API_URL=http://127.0.0.1:5001
# Optional. Sent as "Authorization: Bearer <token>" to IPFS_API_URL, e.g. when the
# node sits behind an authenticating reverse proxy. Leave empty for a local node.
IPFS_API_TOKEN=
# Timeouts in milliseconds
IPFS_TIMEOUT_MS=30000
IPFS_RETRIEVE_TIMEOUT_MS=120000

# Max accepted encrypted upload (MB). Frontend limit is 100 MB plaintext + ~1 KB overhead.
MAX_UPLOAD_SIZE_MB=101
# Per-IP requests per minute on /api/storage
RATE_LIMIT_PER_MINUTE=60

# Used by later phases
CONTRACT_ADDRESS=
SEPOLIA_RPC_URL=
